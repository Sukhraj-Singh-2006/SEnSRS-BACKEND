MONGO_URI=mongodb://127.0.0.1:27017/sensrs
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
TOTP_ISSUER=SEnSRS
TOTP_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# Password-reset email (Gmail requires an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=SEnSRS <your-email@example.com>
